#!/usr/bin/env bash
# Wrapper: runs security.py with the tool's venv (run setup.sh first).
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ ! -x "$HERE/.venv/bin/python" ]; then echo "venv missing: run $HERE/setup.sh" >&2; exit 1; fi
exec "$HERE/.venv/bin/python" "$HERE/security.py" "$@"
